# LiteLLM Configuration
# Copy this to .env for local testing, or configure in Komodo secrets.
# Do NOT commit .env to git.

# ── Required (set in Komodo secrets) ──
LITELLM_MASTER_KEY=sk-your-master-key
LITELLM_SALT_KEY=your-random-salt-key
DATABASE_URL=postgresql://user:password@host:port/litellm

# ── API Keys (for standard providers, optional but recommended) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
