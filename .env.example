# model-hotel Configuration
# Copy to .env and fill in. Do not commit .env.
# See: https://github.com/hugalafutro/model-hotel

# ── Required ──
MASTER_KEY=your-random-master-key
POSTGRES_PASSWORD=your-db-password

# Provider API keys are managed through the UI after startup.
# Open the dashboard at http://localhost:8081 and add:
#   OpenCode Go  → https://opencode.ai/zen/go/v1
#   OpenAI       → https://api.openai.com/v1
#   Anthropic    → https://api.anthropic.com/v1
#   LiteLLM      → http://litellm:4000  (if running alongside)
#   etc.
#
# Models are auto-discovered on provider creation.
# Route as provider/model (e.g., opencode-go/deepseek-v4-flash).
