# LiteLLM Configuration
# Copy this to .env and fill in your values.
# Do NOT commit .env to git (it's gitignored below).

# ── Master Keys ──
LITELLM_MASTER_KEY=sk-your-master-key-here
LITELLM_SALT_KEY=your-random-salt-key-here

# ── API Keys (pay-per-token fallback providers) ──
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
