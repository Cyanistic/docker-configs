# Copy to /etc/secret-run/infisical.env on the machine (chmod 600).
# Do not commit the real file.

# INFISICAL_DOMAIN=https://app.infisical.com
# INFISICAL_PROJECT_ID=

# Machine identity (preferred on a VPS):
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=

# Or a pre-minted token instead of client id/secret:
# INFISICAL_TOKEN=
