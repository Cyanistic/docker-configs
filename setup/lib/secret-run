#!/usr/bin/env bash
# Inject secrets, then exec the given command.
# Callers never name Infisical. The backend lives in /etc/secret-run/config.

set -euo pipefail

die() { printf 'secret-run: %s\n' "$*" >&2; exit 1; }

xdg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/secret-run"
if [ -n "${SECRET_RUN_CONFIG:-}" ]; then
  CONFIG="$SECRET_RUN_CONFIG"
elif [ -f /etc/secret-run/config ]; then
  CONFIG=/etc/secret-run/config
else
  CONFIG="$xdg_dir/config"
fi
if [ -n "${SECRET_RUN_AUTH:-}" ]; then
  AUTH_FILE="$SECRET_RUN_AUTH"
elif [ -f /etc/secret-run/infisical.env ]; then
  AUTH_FILE=/etc/secret-run/infisical.env
else
  AUTH_FILE="$xdg_dir/infisical.env"
fi
PATH_FLAG=""
ENV_FLAG=""

usage() {
  cat <<'EOF'
usage: secret-run [--path FOLDER] [--env ENV] -- command...

  --path   secrets folder. Default: /<basename of cwd>
           (so services/litellm -> /litellm). Override with this flag
           or SECRET_RUN_PATH when the Infisical folder should not match.
  --env    secrets environment (default: prod or SECRET_RUN_ENV)

Backend is chosen by /etc/secret-run/config (installed by setup).
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --path) PATH_FLAG="${2:-}"; shift 2 ;;
    --env) ENV_FLAG="${2:-}"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    --) shift; break ;;
    -*) die "unknown arg: $1" ;;
    *) break ;;
  esac
done

[ $# -gt 0 ] || { usage >&2; exit 1; }

BACKEND=infisical
DEFAULT_ENV=prod
DEFAULT_PATH=""
PROJECT_ID=""

if [ -f "$CONFIG" ]; then
  # shellcheck disable=SC1090
  . "$CONFIG"
fi

ENV_FLAG="${ENV_FLAG:-${SECRET_RUN_ENV:-$DEFAULT_ENV}}"
if [ -z "$PATH_FLAG" ]; then
  PATH_FLAG="${SECRET_RUN_PATH:-${DEFAULT_PATH:-/$(basename "$PWD")}}"
fi

case "$BACKEND" in
  infisical)
    command -v infisical >/dev/null 2>&1 || die "infisical CLI is not installed"
    if [ -f "$AUTH_FILE" ]; then
      set -a
      # shellcheck disable=SC1090
      . "$AUTH_FILE"
      set +a
    fi
    if [ -z "${INFISICAL_TOKEN:-}" ] && [ -n "${INFISICAL_CLIENT_ID:-}" ] && [ -n "${INFISICAL_CLIENT_SECRET:-}" ]; then
      INFISICAL_TOKEN="$(infisical login \
        --method=universal-auth \
        --client-id="$INFISICAL_CLIENT_ID" \
        --client-secret="$INFISICAL_CLIENT_SECRET" \
        --silent --plain)"
      export INFISICAL_TOKEN
    fi
    extra=()
    resolved_project="${INFISICAL_PROJECT_ID:-$PROJECT_ID}"
    if [ -n "$resolved_project" ]; then
      extra+=(--projectId "$resolved_project")
    fi
    exec infisical run --env "$ENV_FLAG" --path "$PATH_FLAG" "${extra[@]}" -- "$@"
    ;;
  none|passthrough)
    exec "$@"
    ;;
  *)
    die "unknown backend '$BACKEND' in $CONFIG"
    ;;
esac
