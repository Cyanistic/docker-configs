# Installed to /etc/secret-run/config by setup if that file does not exist.
# Changing BACKEND is how you swap Infisical for something else later.
# Callers (setup-core, Komodo compose_cmd_wrapper) stay the same.

BACKEND=infisical
DEFAULT_ENV=prod
# Leave DEFAULT_PATH empty to use /<basename of cwd>.
# Set it only if every call on this machine should share one folder.
# DEFAULT_PATH=

# Required when authenticating with a machine identity (not a human login).
# PROJECT_ID=
