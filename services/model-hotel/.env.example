# model-hotel Configuration
# Copy to .env and fill in. Do not commit .env.

# ── Required ──
MASTER_KEY=openssl rand -base64 32
DATABASE_URL=postgresql://user:pass@host:5432/modelhotel

# Git ref to build from (tag or branch). Default in compose is v0.9.99.
# Changing this does not always rebuild; force a rebuild after a bump.
# GIT_REF=v0.9.99

# ── Getting started ──
# After startup, open http://localhost:8081
# Set a password via the UI, then add providers:
#   OpenCode Go  → https://opencode.ai/zen/go/v1
#   OpenAI       → https://api.openai.com/v1
#   Anthropic    → https://api.anthropic.com/v1
#   LiteLLM      → http://litellm:4000  (if running alongside)
#   etc.
#
# Models are auto-discovered on provider creation.
# Route as provider/model (e.g., opencode-go/deepseek-v4-flash).
