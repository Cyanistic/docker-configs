####################################
# KOMODO COMPOSE - NON-SECRETS
####################################
#
# Copy to compose.env and fill in. compose.env is gitignored.
# Secrets are injected by secret-run from Infisical path /komodo-core:
#   KOMODO_DATABASE_URI   Atlas mongodb+srv://... (required)
#   KOMODO_JWT_SECRET
#   KOMODO_WEBHOOK_SECRET
#   KOMODO_INIT_ADMIN_PASSWORD

COMPOSE_KOMODO_IMAGE_TAG="2"
COMPOSE_KOMODO_BACKUPS_PATH=/etc/komodo/backups

TZ=Etc/UTC

# Public URL users (and Periphery) use to reach Core.
KOMODO_HOST=https://komodo.cyanistic.com
KOMODO_TITLE=Komodo

KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub

KOMODO_LOCAL_AUTH=true
KOMODO_INIT_ADMIN_USERNAME=cyan

# First server name Core creates. Periphery --connect-as should match
# if this host is also managed. Stacks in komodo/stacks target "production".
KOMODO_FIRST_SERVER_NAME=production

KOMODO_DISABLE_CONFIRM_DIALOG=false
KOMODO_DISABLE_INIT_RESOURCES=false
KOMODO_DEFAULT_PAGINATION_LIMIT=50
KOMODO_JWT_TTL="1-day"

KOMODO_MONITORING_INTERVAL="15-sec"
KOMODO_RESOURCE_POLL_INTERVAL="1-hr"

KOMODO_DISABLE_USER_REGISTRATION=true
KOMODO_ENABLE_NEW_USERS=false
KOMODO_DISABLE_NON_ADMIN_CREATE=false
KOMODO_TRANSPARENT_MODE=false

KOMODO_OIDC_ENABLED=false
KOMODO_GITHUB_OAUTH_ENABLED=false
KOMODO_GOOGLE_OAUTH_ENABLED=false

KOMODO_LOGGING_PRETTY=false
KOMODO_PRETTY_STARTUP_CONFIG=false
